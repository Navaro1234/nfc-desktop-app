{
  "name": "nfc-desktop-app",
  "version": "1.0.3",
  "description": "NFC Cloud Dashboard Pro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "author": "Navaro",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.navaro.nfcpro",
    "productName": "NFC Master System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NFC Master System"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "navaro1234",
        "repo": "nfc-desktop-app"
      }
    ]
  }
}
